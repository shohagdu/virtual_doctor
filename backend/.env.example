# Local development (MySQL from docker-compose.dev.yml on port 3307)
DATABASE_URL=mysql://vd:vd_dev_password@127.0.0.1:3307/virtual_doctor
BIND_ADDR=127.0.0.1:8080
JWT_SECRET=dev-only-secret-change-me
JWT_TTL_MINUTES=720
CORS_ORIGIN=
STORAGE_DIR=./storage
RUST_LOG=info,sqlx=warn

ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_COMPLEX=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# SMS: "log" (nothing is sent) or "bulksmsbd"
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
