# ---- Docker Compose (production) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=virtual_doctor
MYSQL_USER=vd
MYSQL_PASSWORD=change-me
HTTP_PORT=80

# ---- Backend ----
# Set automatically in docker-compose.yml; for local dev see backend/.env.example
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
RUST_LOG=info,sqlx=warn

# ---- Claude API (Anthropic Console) — backend only, never exposed to the browser ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_COMPLEX=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# ---- SMS gateway (backend only) ----
# "log" sends nothing and only logs (development); "bulksmsbd" uses BulkSMSBD.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
