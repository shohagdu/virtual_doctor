[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
# Binary logs for point-in-time recovery (Patient_Management_Spec §9.4)
log-bin = mysql-bin
binlog_expire_logs_seconds = 1209600
# Enables 2-character tokens for Bangla/partial name FULLTEXT search
ngram_token_size = 2
